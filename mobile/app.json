{
  "expo": {
    "name": "Vaani",
    "slug": "vaani",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Vaani uses the microphone to hear and translate what you say."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7A5A45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Vaani uses the microphone to hear and translate what you say."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F7F5F2",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121110"
          }
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-status-bar"
    ],
    "backgroundColor": "#F7F5F2"
  }
}
